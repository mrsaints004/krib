# Copy this file to .env.local and fill in real values from
# Supabase → Project Settings → API. Never commit .env.local to git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SECRET — server-only, bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# App URL — used for CSRF origin validation on API routes.
# Set to your production domain (e.g. https://krib.ng).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack — payment processing for bookings.
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys for development, live keys for production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
